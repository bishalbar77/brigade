# Copy to .env.local and fill from the Supabase dashboard.
# .env.local is gitignored. Never commit real values.

# Settings → Data API → Project URL. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Settings → API keys → the PUBLIC key.
# Legacy `anon` JWT (eyJ...) or newer `sb_publishable_...`. Safe in the browser:
# every query it makes is still subject to RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Settings → API keys → the SECRET key.
# DANGER: bypasses RLS entirely. Used ONLY by supabase/seed/seed.ts.
# Never expose as NEXT_PUBLIC_*, never import into a client component.
# Treat it like a database password, because it is one.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres password for the `postgres` role — NOT an API key and not
# interchangeable with the keys above. Used by `supabase link` / direct psql.
# Settings → Database → Reset database password (if you don't have it).
SUPABASE_DB_PASSWORD=

# http://localhost:3000 locally; the real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
