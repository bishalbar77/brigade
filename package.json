{
  "name": "brigade",
  "version": "0.1.0",
  "private": true,
  "description": "Restaurant operations platform \u2014 the menu as a live function of the pantry.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sql:bundle": "node scripts/bundle-sql.mjs",
    "seed": "tsx --env-file=.env.local supabase/seed/seed.ts",
    "images": "tsx --env-file=.env.local scripts/fetch-dish-images.ts",
    "verify:data": "tsx --env-file=.env.local scripts/verify-data.ts",
    "verify:features": "node --env-file=.env.local scripts/verify-features.mjs",
    "sql:check": "bash scripts/sql-check.sh",
    "sql:lint": "node scripts/sql-lint.mjs",
    "check": "bash scripts/check-all.sh"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.10",
    "motion": "^11.15.0",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/ws": "^8.18.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "ws": "^8.21.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
